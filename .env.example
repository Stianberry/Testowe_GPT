# W cloud wpisz wartości w ustawieniach środowiska.
# Na swoim komputerze skopiuj ten plik do ignorowanego .env i uzupełnij lokalnie.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
TAVILY_API_KEY=
POSTIZ_API_KEY=
# Opcjonalne; lokalne awatary nie potrzebują klucza HeyGen.
HEYGEN_API_KEY=
PEXELS_API_KEY=
